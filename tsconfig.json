{
    "include": [
        "./src/**/*",
        "./vite.config.ts"
    ],
    "compilerOptions": {
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ESNext",
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["vite/client"],
        "lib": [
            "dom",
            "es2015"
        ],
        "jsx": "react-jsx"
    }
}
